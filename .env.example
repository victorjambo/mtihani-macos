# Required Supabase Storage configuration. Keep the real service-role key secret.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional release destinations and tool locations.
SUPABASE_RELEASE_BUCKET="mtihani-releases"
DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
SPARKLE_BIN="/absolute/path/to/mtihani-macos/build/SourcePackages/artifacts/sparkle/Sparkle/bin"
SPARKLE_KEY_ACCOUNT="mtihani"
FRONTEND_APPCAST_PATH="/absolute/path/to/mtihani-app/apps/frontend/public/appcast.xml"

# Optional CI-only alternative to the local Sparkle signing key in Keychain.
# Keep this file outside the repository and never commit the private key.
SPARKLE_PRIVATE_KEY_FILE="/secure/path/outside/repository/sparkle-private-key"
